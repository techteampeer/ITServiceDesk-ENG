# ============ Modo ============
# MOCK=true corre TODO el flujo sin credenciales (Gemini y Jira simulados).
# Cambia a false cuando conectes Vertex y Jira reales.
MOCK=true
PORT=8787

# ============ Vertex AI (Gemini) ============
GCP_PROJECT=tu-proyecto-gcp
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Autenticación por Application Default Credentials:
#   Local:   gcloud auth application-default login
#   Servidor: GOOGLE_APPLICATION_CREDENTIALS=/ruta/service-account.json

# ============ Jira Cloud ============
JIRA_DOMAIN=itexpert-team.atlassian.net
JIRA_EMAIL=tu-correo@dominio.com
JIRA_API_TOKEN=pega-tu-api-token-aqui
JIRA_PROJECT_KEY=SUP
JIRA_ISSUE_TYPE_ID=10039
# IDs de transición del workflow de SUP.
# Descúbrelos con:  GET http://localhost:8787/api/jira/transitions/SUP-XX
JIRA_TRANSITION_CLOSE_ID=
JIRA_TRANSITION_ESCALATE_ID=

# ============ Integraciones externas (Teams / Power Automate) ============
# Clave que deben enviar los llamadores en el header X-API-Key.
# Genera una larga y aleatoria, ej: openssl rand -hex 24
INTEGRATION_API_KEY=

# ============ Idioma de la aplicación ============
# es (default) | en — controla prompts, corpus (corpus_en.json), textos de la UI y del ticket
APP_LANG=es
